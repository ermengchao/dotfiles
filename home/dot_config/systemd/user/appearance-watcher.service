; [Unit]
; Description=Synchronize desktop appearance with fish
;
; [Service]
; Type=simple
; ExecStart=/usr/bin/env fish -c 'is_dark_mode; gsettings monitor org.gnome.desktop.interface color-scheme | while read -l event; is_dark_mode; end'
; Restart=on-failure
; RestartSec=1
;
; [Install]
; WantedBy=default.target
