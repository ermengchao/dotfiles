{
  "dns": {
    "rules": [
      {
        "preferred_by": "dns-hosts",
        "action": "route",
        "server": "dns-hosts"
      },
      {
        "domain_suffix": [
          "arpa",
          "local"
        ],
        "action": "route",
        "server": "dns-dhcp"
      },
      {
        "domain_suffix": [
          "pool.ntp.org",
          "time.apple.com"
        ],
        "action": "route",
        "server": "doh-cloudflare"
      },
      {
        "domain_suffix": [
          "taileee60e.ts.net"
        ],
        "action": "route",
        "server": "dns-local"
      },
      {
        "domain_suffix": [
          "proxy.er-meng.com"
        ],
        "action": "route",
        "server": "dns-aliyun-bootstrap"
      },
      {
        "domain_regex": [
          "^xbox\\.[^.]+\\.microsoft\\.com$"
        ],
        "domain_suffix": [
          "xboxlive.com",
          "stun.playstation.net",
          "srv.nintendo.net",
          "battlenet.com.cn",
          "battlenet.com",
          "blzstatic.cn",
          "battle.net"
        ],
        "action": "route",
        "server": "doh-cloudflare"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "doh-cloudflare"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "dns-fakeip"
      },
      {
        "rule_set": [
          "geosite-cn",
          "direct_chao",
          "direct",
          "download"
        ],
        "action": "route",
        "server": "dns-local"
      },
      {
        "action": "evaluate",
        "server": "dns-local"
      },
      {
        "match_response": true,
        "rule_set": [
          "apple",
          "china_max",
          "lan"
        ],
        "action": "respond"
      },
      {
        "rule_set": [
          "claude",
          "gemini",
          "disney",
          "hbo_usa",
          "tiktok",
          "youtube_music",
          "developer",
          "apple_proxy",
          "github"
        ],
        "action": "route",
        "server": "dns-fakeip"
      },
      {
        "match_response": true,
        "rule_set": [
          "copilot",
          "openai",
          "game_chao",
          "game",
          "netflix",
          "spotify",
          "youtube",
          "proxy_chao",
          "amazon_cloud",
          "google",
          "global"
        ],
        "action": "route",
        "server": "dns-fakeip"
      },
      {
        "inbound": [
          "socks-in",
          "http-in",
          "tun-in"
        ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "dns-fakeip"
      }
    ]
  }
}
