{
  "outbounds": [
    {
      "tag": "🟢 Direct",
      "type": "direct"
    },
    {
      "tag": "🌐 Proxy",
      "type": "selector",
      "outbounds": [
        "✨ Auto",
        "🇯🇵 Japan 01",
        "🇯🇵 Japan 02",
        "🇯🇵 Japan 03",
        "🇯🇵 Japan 04",
        "🇯🇵 Japan 05",
        "🇯🇵 Japan 06",
        "🇯🇵 Japan 07"
      ],
      "default": "✨ Auto"
    },
    {
      "tag": "✨ Auto",
      "type": "urltest",
      "outbounds": [
        "🇯🇵 Japan 01",
        "🇯🇵 Japan 02",
        "🇯🇵 Japan 03",
        "🇯🇵 Japan 04",
        "🇯🇵 Japan 05",
        "🇯🇵 Japan 06",
        "🇯🇵 Japan 07"
      ],
      "url": "http://www.google.com/generate_204",
      "interval": "300s"
    },
    {
      "tag": "🇯🇵 Japan 01",
      "type": "shadowsocks",
      "server": "apne1-01.proxy.er-meng.com",
      "domain_resolver": "dns-local",
      "server_port": {{ .ports.proxy.shadowsocks }},
      "method": "2022-blake3-aes-128-gcm",
      "password": {{ onepasswordRead "op://Development/Proxy/shadowsocks/password" | quote }}
    },
    {
      "tag": "🇯🇵 Japan 02",
      "type": "vmess",
      "server": "apne1-01.proxy.er-meng.com",
      "server_port": 443,
      "domain_resolver": "dns-local",
      "uuid": {{ onepasswordRead "op://Development/Proxy/vmess/password" | quote }},
      "security": "auto",
      "alter_id": 0,
      "tcp_fast_open": true,
      "tls": {
        "enabled": true,
        "server_name": "apne1-01.proxy.er-meng.com"
      },
      "transport": {
        "type": "ws",
        "path": "/{{ onepasswordRead "op://Development/Proxy/vmess/password" }}",
        "headers": {
          "Host": "apne1-01.proxy.er-meng.com"
        }
      }
    },
    {
      "tag": "🇯🇵 Japan 03",
      "type": "trojan",
      "server": "apne1-01.proxy.er-meng.com",
      "domain_resolver": "dns-local",
      "server_port": {{ .ports.proxy.trojan }},
      "password": {{ onepasswordRead "op://Development/Proxy/trojan/password" | quote }},
      "tls": {
        "enabled": true,
        "server_name": "apne1-01.proxy.er-meng.com"
      }
    },
    {
      "tag": "🇯🇵 Japan 04",
      "type": "snell",
      "server": "apne1-01.proxy.er-meng.com",
      "domain_resolver": "dns-local",
      "server_port": {{ .ports.proxy.snell }},
      "version": 6,
      "psk": {{ onepasswordRead "op://Development/Proxy/snell/password" | quote }},
      "reuse": true
    },
    {
      "tag": "🇯🇵 Japan 05",
      "type": "tuic",
      "server": "apne1-01.proxy.er-meng.com",
      "domain_resolver": "dns-local",
      "server_port": {{ .ports.proxy.tuic }},
      "uuid": {{ onepasswordRead "op://Development/Proxy/tuic/password" | quote }},
      "password": {{ onepasswordRead "op://Development/Proxy/tuic/password" | quote }},
      "congestion_control": "bbr",
      "zero_rtt_handshake": false,
      "tls": {
        "enabled": true,
        "server_name": "apne1-01.proxy.er-meng.com",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "tag": "🇯🇵 Japan 06",
      "type": "hysteria2",
      "server": "apne1-01.proxy.er-meng.com",
      "domain_resolver": "dns-local",
      "server_port": {{ .ports.proxy.hysteria2 }},
      "password": {{ onepasswordRead "op://Development/Proxy/hysteria2/password" | quote }},
      "tls": {
        "enabled": true,
        "server_name": "apne1-01.proxy.er-meng.com"
      }
    },
    {
      "tag": "🇯🇵 Japan 07",
      "type": "anytls",
      "server": "apne1-01.proxy.er-meng.com",
      "domain_resolver": "dns-local",
      "server_port": {{ .ports.proxy.anytls }},
      "password": {{ onepasswordRead "op://Development/Proxy/anytls/password" | quote }},
      "tls": {
        "enabled": true,
        "server_name": "apne1-01.proxy.er-meng.com"
      }
    },
    {
      "tag": "🧠 AI",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🟢 Direct"
      ],
      "default": "🌐 Proxy"
    },
    {
      "tag": "🎮 Game",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🟢 Direct"
      ],
      "default": "🌐 Proxy"
    },
    {
      "tag": "🎥 Media",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🟢 Direct"
      ],
      "default": "🌐 Proxy"
    },
    {
      "tag": "🐟 Final",
      "type": "selector",
      "outbounds": [
        "🌐 Proxy",
        "🟢 Direct"
      ],
      "default": "🌐 Proxy"
    },
    {
      "tag": "Mac mini",
      "type": "snell",
      "version": 6,
      "server": "mac-mini.taileee60e.ts.net",
      "server_port": {{ .ports.proxy.snell }},
      "psk": {{ onepasswordRead "op://Development/Proxy/snell/password" | quote }},
      "mode": "default",
      "reuse": true,
      "detour": "Tailnet",
      "domain_resolver": "dns-tailnet"
    },
    {
      "tag": "🚪 ExitNode",
      "type": "selector",
      "outbounds": [
        "Tailnet",
        "Mac mini"
      ],
      "default": "Tailnet"
    }
  ]
}
