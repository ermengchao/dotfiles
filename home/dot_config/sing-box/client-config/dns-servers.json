{
  "dns": {
    "servers": [
      {
        "tag": "dns-hosts",
        "type": "hosts",
        "predefined": {
          "homeassistant.local": "10.10.10.17"
        }
      },
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "tag": "dns-tailnet",
        "type": "tailscale",
        "endpoint": "Tailnet"
      },
      {
        "tag": "dns-fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fdfe::/18"
      },
      {
        "tag": "doh-cloudflare",
        "type": "https",
        "server": "cloudflare-dns.com",
        "path": "/dns-query",
        "domain_resolver": "dns-local",
        "detour": "🌐 Proxy"
      },
      {
        "tag": "doh-cloudflare-direct",
        "type": "https",
        "server": "cloudflare-dns.com",
        "path": "/dns-query",
        "domain_resolver": "dns-local",
        "detour": "🟢 Direct"
      },
      {
        "tag": "doh-aliyun",
        "type": "https",
        "server": "dns.alidns.com",
        "path": "/dns-query",
        "domain_resolver": "dns-local",
        "detour": "🟢 Direct"
      }
    ]
  }
}
