{
  "inbounds": [
    {
      "tag": "inbounds-shadowtls",
      "type": "shadowtls",
      "listen": "::",
      "listen_port": {{ .ports.proxy.shadowtls }},
      "version": 3,
      "detour": "inbounds-shadowsocks",
      "users": [
        {
          "password": {{ onepasswordRead "op://Development/Proxy/shadowtls/password" | quote }}
        }
      ],
      "handshake": {
        "server": "{{ .meta.hostname }}.proxy.er-meng.com",
        "server_port": 443
      },
      "strict_mode": true
    },
    {
      "tag": "inbounds-shadowsocks",
      "type": "shadowsocks",
      "listen": "::",
      "listen_port": {{ .ports.proxy.shadowsocks }},
      "network": "tcp",
      "method": "2022-blake3-aes-128-gcm",
      "password": {{ onepasswordRead "op://Development/Proxy/shadowsocks/password" | quote }},
      "multiplex": {
        "enabled": true
      }
    },
    {
      "tag": "inbounds-vmess",
      "type": "vmess",
      "listen": "::",
      "listen_port": {{ .ports.proxy.vmess }},
      "tcp_fast_open": true,
      "proxy_protocol": false,
      "users": [
        {
          "uuid": {{ onepasswordRead "op://Development/Proxy/vmess/password" | quote }},
          "alterId": 0
        }
      ],
      "transport": {
        "type": "ws",
        "path": "/{{ onepasswordRead "op://Development/Proxy/vmess/password" }}",
        "max_early_data": 2560,
        "early_data_header_name": "Sec-WebSocket-Protocol"
      },
      "multiplex": {
        "enabled": true,
        "padding": true,
        "brutal": {
          "enabled": true,
          "up_mbps": 1000,
          "down_mbps": 1000
        }
      }
    },
    {
      "tag": "inbounds-trojan",
      "type": "trojan",
      "listen": "::",
      "listen_port": {{ .ports.proxy.trojan }},
      "users": [
        {
          "name": "chao",
          "password": {{ onepasswordRead "op://Development/Proxy/trojan/password" | quote }}
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{ .meta.hostname }}.proxy.er-meng.com",
        "acme": {
          "domain": "{{ .meta.hostname }}.proxy.er-meng.com",
          "email": {{ onepasswordRead "op://Development/Cloudflare/email" | quote }},
          "dns01_challenge": {
            "provider": "cloudflare",
            "api_token": {{ onepasswordRead "op://Development/Cloudflare/token" | quote }}
          }
        }
      },
      "multiplex": {
        "enabled": true
      }
    },
    {
      "tag": "inbounds-snell",
      "type": "snell",
      "version": 6,
      "listen": "::",
      "listen_port": {{ .ports.proxy.snell }},
      "psk": {{ onepasswordRead "op://Development/Proxy/snell/password" | quote }}
    },
    {
      "tag": "inbounds-naive",
      "type": "naive",
      "listen": "::",
      "listen_port": {{ .ports.proxy.naive }},
      "users": [
        {
          "username": "chao",
          "password": {{ onepasswordRead "op://Development/Proxy/naive/password" | quote }}
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{ .meta.hostname }}.proxy.er-meng.com",
        "acme": {
          "domain": "{{ .meta.hostname }}.proxy.er-meng.com",
          "email": {{ onepasswordRead "op://Development/Cloudflare/email" | quote }},
          "dns01_challenge": {
            "provider": "cloudflare",
            "api_token": {{ onepasswordRead "op://Development/Cloudflare/token" | quote }}
          }
        }
      }
    },
    {
      "tag": "inbounds-tuic",
      "type": "tuic",
      "listen": "::",
      "listen_port": {{ .ports.proxy.tuic }},
      "users": [
        {
          "uuid": {{ onepasswordRead "op://Development/Proxy/tuic/password" | quote }},
          "password": {{ onepasswordRead "op://Development/Proxy/tuic/password" | quote }}
        }
      ],
      "congestion_control": "bbr",
      "zero_rtt_handshake": false,
      "tls": {
        "enabled": true,
        "alpn": [
          "h3"
        ],
        "server_name": "{{ .meta.hostname }}.proxy.er-meng.com",
        "acme": {
          "domain": "{{ .meta.hostname }}.proxy.er-meng.com",
          "email": {{ onepasswordRead "op://Development/Cloudflare/email" | quote }},
          "dns01_challenge": {
            "provider": "cloudflare",
            "api_token": {{ onepasswordRead "op://Development/Cloudflare/token" | quote }}
          }
        }
      }
    },
    {
      "tag": "inbounds-anytls",
      "type": "anytls",
      "listen": "::",
      "listen_port": {{ .ports.proxy.anytls }},
      "users": [
        {
          "password": {{ onepasswordRead "op://Development/Proxy/anytls/password" | quote }}
        }
      ],
      "padding_scheme": [],
      "tls": {
        "enabled": true,
        "server_name": "{{ .meta.hostname }}.proxy.er-meng.com",
        "acme": {
          "domain": "{{ .meta.hostname }}.proxy.er-meng.com",
          "email": {{ onepasswordRead "op://Development/Cloudflare/email" | quote }},
          "dns01_challenge": {
            "provider": "cloudflare",
            "api_token": {{ onepasswordRead "op://Development/Cloudflare/token" | quote }}
          }
        }
      }
    },
    {
      "tag": "inbounds-hysteria2",
      "type": "hysteria2",
      "listen": "::",
      "listen_port": {{ .ports.proxy.hysteria2 }},
      "up_mbps": 100,
      "down_mbps": 100,
      "users": [
        {
          "name": "chao",
          "password": {{ onepasswordRead "op://Development/Proxy/hysteria2/password" | quote }}
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{ .meta.hostname }}.proxy.er-meng.com",
        "acme": {
          "domain": "{{ .meta.hostname }}.proxy.er-meng.com",
          "email": {{ onepasswordRead "op://Development/Cloudflare/email" | quote }},
          "dns01_challenge": {
            "provider": "cloudflare",
            "api_token": {{ onepasswordRead "op://Development/Cloudflare/token" | quote }}
          }
        }
      }
    }
  ]
}
