[icloud]
type = iclouddrive
apple_id = {{ onepasswordRead "op://Development/Rclone/icloud drive/apple id" }}
password = {{ onepasswordRead "op://Development/Rclone/icloud drive/password" }}

[r2]
type = s3
provider = Cloudflare
access_key_id = {{ onepasswordRead "op://Development/Rclone/s3/access key id" }}
secret_access_key = {{ onepasswordRead "op://Development/Rclone/s3/secret access key" }}
endpoint = {{ onepasswordRead "op://Development/Rclone/s3/endpoint" }}
acl = private
