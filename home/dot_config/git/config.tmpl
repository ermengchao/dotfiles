{{- $helper := "!op plugin run -- gh auth git-credential" -}}
{{- if or (env "OP_SERVICE_ACCOUNT_TOKEN") (env "OP_SESSION") -}}
{{- $helper = "!env GH_TOKEN='op://Development/GitHub Personal Access Token/token' op run --no-masking -- gh auth git-credential" -}}
{{- end -}}

[user]
  name = {{ .fullname }}
  email = {{ .email }}
  # signingkey =
  useConfigOnly = true
[core]
  autocrlf = input
  ignorecase = true
  excludesfile = {{ env "XDG_CONFIG_HOME" }}/git/ignore
[color]
  ui = auto
[init]
  defaultBranch = main
[filter "lfs"]
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
[pull]
	rebase = true
[include]
  path = {{ env "XDG_CONFIG_HOME" }}/git/delta.gitconfig
[credential "https://github.com"]
	helper = 
	helper = {{ $helper | quote }}
[credential "https://gist.github.com"]
	helper = 
	helper = {{ $helper | quote }}
