bindAddr = "0.0.0.0"
bindPort = {{ .ports.frp.server }}

vhostHTTPPort = 80
vhostHTTPSPort = 443

enablePrometheus = true

[webServer]
addr = "0.0.0.0"
port = {{ .ports.frp.web_server }}
user = "chao"
password = {{ gopass "chao/password" | quote }}
tls.certFile = "server.crt"
tls.keyFile = "server.key"

[auth]
method = "token"
token = {{ gopass "frp/token" | quote }}
