bindAddr = "0.0.0.0"
bindPort = {{ .ports.frp.server }}

log.to = "console"
log.level = "info"

vhostHTTPPort = 80
vhostHTTPSPort = 443

enablePrometheus = true

[webServer]
addr = "0.0.0.0"
port = {{ .ports.frp.web_server }}
user = "chao"
password = {{ onepasswordRead "op://Development/chao/password" | quote }}
tls.certFile = "server.crt"
tls.keyFile = "server.key"

[auth]
method = "token"
token = {{ onepasswordRead "op://Development/FRP/token" | quote }}
