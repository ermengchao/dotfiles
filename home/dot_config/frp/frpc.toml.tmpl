serverAddr = "iptv.app.er-meng.com"
serverPort = {{ .ports.frp.server }}

log.to = "console"
log.level = "info"

[auth]
method = "token"
token = {{ onepasswordRead "op://Development/FRP/token" | quote }}

[[proxies]]
name = "iptv"
type = "tcp"
localIP = "127.0.0.1"
localPort = {{ .ports.rtp2httpd }}
remotePort = {{ .ports.frp.iptv }}
