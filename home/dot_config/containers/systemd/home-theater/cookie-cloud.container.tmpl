[Unit]
Description = Movie Pilot Container

[Service]
Restart = on-failure

[Container]
ContainerName = cookie-cloud
Image = docker.io/easychen/cookiecloud:latest
AutoUpdate = registry

Network = bridge
PublishPort = 0.0.0.0:{{ .ports.cookie_cloud }}:8088
PublishPort = [::]:{{ .ports.cookie_cloud }}:8088
