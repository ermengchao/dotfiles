#!/usr/bin/env fish

set -g container_name auto_bangumi

function create_container
    if command container inspect $container_name >/dev/null 2>&1
        echo "$container_name already exists"
        return 0
    end

    command mkdir -p \
        "{{ env "XDG_CONFIG_HOME" }}/auto_bangumi" \
        "{{ env "XDG_DATA_HOME" }}/auto_bangumi"
    command container image pull ghcr.io/estrellaxd/auto_bangumi:latest >/dev/null; or return 1

    command container create \
        --name $container_name \
        --entrypoint /entry-host.sh \
        --env 'TZ={{ template "getSystemTimezone" . }}' \
        --env UMASK=022 \
        --publish '[::]:{{ .ports.auto_bangumi }}:{{ .ports.auto_bangumi }}' \
        --volume '{{ env "XDG_CONFIG_HOME" }}/auto_bangumi/entry-host.sh:/entry-host.sh:ro' \
        --volume '{{ env "XDG_CONFIG_HOME" }}/auto_bangumi:/app/config' \
        --volume '{{ env "XDG_DATA_HOME" }}/auto_bangumi:/app/data' \
        ghcr.io/estrellaxd/auto_bangumi:latest
end

create_container
