#!/usr/bin/env fish

set -g container_name qbittorrent

function create_container
    if command container inspect $container_name >/dev/null 2>&1
        echo "$container_name already exists"
        return 0
    end

    command mkdir -p \
        "{{ env "XDG_CONFIG_HOME" }}/qbittorrent" \
        "{{ .paths.media }}/downloads/qbittorrent"
    command container image pull lscr.io/linuxserver/qbittorrent:latest >/dev/null; or return 1

    command container create \
        --name $container_name \
        --env 'TZ={{ template "getSystemTimezone" . }}' \
        --env WEBUI_PORT=3000 \
        --env TORRENTING_PORT=3001 \
        --publish '[::]:{{ .ports.qbittorrent.webui }}:{{ .ports.qbittorrent.webui }}' \
        --publish '[::]:{{ .ports.qbittorrent.session }}:{{ .ports.qbittorrent.session }}' \
        --publish '[::]:{{ .ports.qbittorrent.session }}:{{ .ports.qbittorrent.session }}/udp' \
        --volume '{{ env "XDG_CONFIG_HOME" }}/qbittorrent:/config' \
        --volume '{{ .paths.media }}/downloads/qbittorrent:/downloads' \
        lscr.io/linuxserver/qbittorrent:latest
end

create_container
