#!/usr/bin/env fish

set -g container_name cookie-cloud

function create_container
    if command container inspect $container_name >/dev/null 2>&1
        echo "$container_name already exists"
        return 0
    end

    command container image pull docker.io/easychen/cookiecloud:latest >/dev/null; or return 1
    command container create \
        --name $container_name \
        --publish '[::]:{{ .ports.cookie_cloud }}:8088' \
        docker.io/easychen/cookiecloud:latest
end

create_container
