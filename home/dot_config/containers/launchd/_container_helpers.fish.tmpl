set -g container_bin "{{ env "HOMEBREW_PREFIX" }}/bin/container"

function ensure_container_system
    if $container_bin system status >/dev/null 2>&1
        return 0
    end

    $container_bin system start --disable-kernel-install >/dev/null
end

function container_exists
    $container_bin inspect $container_name >/dev/null 2>&1
end

function container_is_running
    $container_bin list --all 2>/dev/null \
        | string match -rq -- "^$container_name[[:space:]].*[[:space:]]running[[:space:]]"
end

function ensure_named_volume --argument-names volume_name
    if not $container_bin volume inspect $volume_name >/dev/null 2>&1
        $container_bin volume create $volume_name >/dev/null
    end
end

function container_main
    ensure_container_system; or return 1
    create_container; or return 1

    if test "$argv[1]" = supervise
        if container_is_running
            echo "$container_name is already running; leaving it untouched"
            return 0
        end

        exec $container_bin start --attach $container_name
    end

    echo "Created $container_name. Start it with: container start $container_name"
end
