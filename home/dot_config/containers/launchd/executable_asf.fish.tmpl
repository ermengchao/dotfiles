#!/usr/bin/env fish

set -g container_name asf

function create_container
    if command container inspect $container_name >/dev/null 2>&1
        echo "$container_name already exists"
        return 0
    end

    command mkdir -p "{{ env "XDG_CONFIG_HOME" }}/asf"
    command container image pull docker.io/justarchi/archisteamfarm >/dev/null; or return 1

    set -l uid (id -u)
    command container create \
        --name $container_name \
        --env "ASF_UID=$uid" \
        --publish '[::]:{{ .ports.asf }}:1242' \
        --volume '{{ env "XDG_CONFIG_HOME" }}/asf:/app/config' \
        docker.io/justarchi/archisteamfarm
end

create_container
