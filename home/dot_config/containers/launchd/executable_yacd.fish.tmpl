#!{{ env "HOMEBREW_PREFIX" }}/bin/fish

source "{{ env "XDG_CONFIG_HOME" }}/containers/launchd/_container_helpers.fish"

set -g container_name yacd

function create_container
    container_exists; and return 0

    $container_bin image pull docker.io/haishanh/yacd:latest >/dev/null; or return 1
    $container_bin create \
        --name $container_name \
        --publish '[::]:{{ .ports.yacd }}:80' \
        docker.io/haishanh/yacd:latest
end

container_main $argv
