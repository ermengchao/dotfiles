#!/usr/bin/env fish

set -g container_name jm2epub

function create_container
    if command container inspect $container_name >/dev/null 2>&1
        echo "$container_name already exists"
        return 0
    end

    command container image pull ghcr.io/ermengchao/jm2epub >/dev/null; or return 1
    command container create \
        --name $container_name \
        --env 'JM2EPUB_API_KEY={{ gopass "jm2epub/api_key" }}' \
        --env 'PORT={{ .ports.jm2epub }}' \
        --publish '[::]:{{ .ports.jm2epub }}:{{ .ports.jm2epub }}' \
        ghcr.io/ermengchao/jm2epub
end

create_container
