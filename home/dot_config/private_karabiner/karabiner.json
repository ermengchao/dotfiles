{
    "global": {
        "show_in_menu_bar": false,
        "enable_cgeventtap_fallback": true
    },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Map F3 to control+option+shift+command+H and F4 to control+option+shift+command+B",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "f3",
                                    "modifiers": { "optional": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "key_code": "h",
                                        "modifiers": ["left_control", "left_option", "left_shift", "left_command"]
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "f4",
                                    "modifiers": { "optional": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "key_code": "b",
                                        "modifiers": ["left_control", "left_option", "left_shift", "left_command"]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Caps Lock sends fn+control with other keys, Caps Lock when tapped, and toggles Caps Lock when held for 500 ms",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 500,
                                    "basic.to_if_held_down_threshold_milliseconds": 500
                                },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "lazy": true,
                                        "modifiers": ["fn"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "caps_lock" }],
                                "to_if_held_down": [
                                    {
                                        "shell_command": "/usr/bin/open -g hammerspoon://caps-lock-toggle"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Caps Lock Revolution",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}
