name: query datasource
method: POST
url: https://api.notion.com/v1/data_sources/2ba346a8-9c74-8073-844f-000b90ccd846/query
body:
  content: |-
    {
      "filter": {
        "property": "rawAmount",
        "number": {
          "equals": -0.2
        }
      }
    }
  content_type: application/json
headers:
- name: Authorization
  value: Bearer {{ gopass "notion/bookkeeping" }}
- name: Notion-Version
  value: '2026-03-11'
- name: Content-Type
  value: application/json
