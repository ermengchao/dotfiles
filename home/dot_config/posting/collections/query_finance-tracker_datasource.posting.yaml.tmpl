name: query datasource
method: POST
url: https://api.notion.com/v1/data_sources/{{ gopass "notion/finance_tracker/transactions" }}/query
body:
  content: |-
    {
      "filter": {
        "property": "rawAmount",
        "number": {
          "equals": -0.2
        }
      }
    }
  content_type: application/json
headers:
- name: Authorization
  value: Bearer {{ gopass "notion/finance_tracker/access_token" }}
- name: Notion-Version
  value: '2026-03-11'
- name: Content-Type
  value: application/json
