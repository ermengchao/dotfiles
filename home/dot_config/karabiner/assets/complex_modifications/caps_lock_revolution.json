{
  "title": "Caps Lock Revolution",
  "rules": [
    {
      "description": "Change caps_lock to globe+control if pressed with other keys, post caps_lock if pressed alone",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 250,
            "basic.to_if_held_down_threshold_milliseconds": 250
          },
          "to": [
            {
              "key_code": "left_control",
              "lazy": true,
              "modifiers": [
                "fn"
              ]
            }
          ],
          "to_if_alone": [
            {
              "key_code": "caps_lock"
            }
          ],
          "to_if_held_down": [
            {
              "key_code": "left_control",
              "modifiers": [
                "fn"
              ]
            }
          ]
        }
      ]
    }
  ]
}
