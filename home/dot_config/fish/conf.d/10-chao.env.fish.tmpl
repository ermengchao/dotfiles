{{ if eq .chezmoi.os "darwin" -}}
set -gx XDG_RUNTIME_DIR ~/.local/state

set -gx ICLOUD ~/Library/Mobile\ Documents/com~apple~CloudDocs

set -gx CPPFLAGS -I/opt/homebrew/opt/openjdk/include
set -gx JAVA_HOME /opt/homebrew/opt/openjdk

set -gx ORBENV IS_DARK_MODE:TERM_PROGRAM

set -gx PUPPETEER_EXECUTABLE_PATH "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
{{ end -}}

set -gx XDG_CACHE_HOME ~/.cache
set -gx XDG_CONFIG_HOME ~/.config
set -gx XDG_DATA_HOME ~/.local/share
set -gx XDG_STATE_HOME ~/.local/state

set -U fish_greeting
set -g fish_key_bindings fish_vi_key_bindings

set -gx EDITOR nvim
set -gx VISUAL nvim
set -gx PAGER bat

if status is-interactive
    set -gx GPG_TTY (tty)
end

if is_proxy_listening
    set -gx all_proxy socks5h://127.0.0.1:{{ .ports.proxy.socks }}
    set -gx http_proxy http://127.0.0.1:{{ .ports.proxy.http }}
    set -gx https_proxy http://127.0.0.1:{{ .ports.proxy.http }}
    set -gx no_proxy 127.0.0.1,0.0.0.0,localhost,::1

    set -gx ALL_PROXY socks5h://127.0.0.1:{{ .ports.proxy.socks }}
    set -gx HTTP_PROXY http://127.0.0.1:{{ .ports.proxy.http }}
    set -gx HTTPS_PROXY http://127.0.0.1:{{ .ports.proxy.http }}
    set -gx NO_PROXY 127.0.0.1,0.0.0.0,localhost,::1
end

set -gx ANSIBLE_HOME $XDG_DATA_HOME/ansible
set -gx ANSIBLE_INVENTORY $XDG_CONFIG_HOME/ansible/inventory.ini

set -gx AWS_CONFIG_FILE $XDG_CONFIG_HOME/aws/config
set -gx AWS_DATA_PATH $XDG_DATA_HOME/aws/models
set -gx AWS_SHARED_CREDENTIALS_FILE $XDG_CONFIG_HOME/aws/credentials

set -gx BUN_INSTALL_BIN ~/.local/bin
set -gx BUN_INSTALL_GLOBAL_DIR $XDG_DATA_HOME/bun
set -gx BUN_INSTALL_CACHE_DIR $XDG_CACHE_HOME/bun

set -gx CODEX_HOME $XDG_CONFIG_HOME/codex

set -gx EZA_ICONS_AUTO 1

set -gx FZF_DEFAULT_COMMAND "fd --type f"

set -gx GOPASS_SSH_DIR ~/.ssh

set -gx HOMEBREW_API_AUTO_UPDATE_SECS 600
set -gx HOMEBREW_AUTO_UPDATE_SECS 3600
set -gx HOMEBREW_BAT 1
set -gx HOMEBREW_BAT_CONFIG_PATH $XDG_CONFIG_HOME/bat/config
set -gx HOMEBREW_CACHE $XDG_CACHE_HOME/Homebrew
set -gx HOMEBREW_CLEANUP_MAX_AGE_DAYS 1
set -gx HOMEBREW_DISPLAY_INSTALL_TIMES 1
set -gx HOMEBREW_NO_INSTALL_CLEAN
set -gx HOMEBREW_NO_ENV_HINTS 1
set -gx HOMEBREW_UPGRADE_GREEDY 1
set -gx WHALEBREW_CONFIG_DIR $XDG_CONFIG_HOME/whalebrew
set -gx WHALEBREW_INSTALL_PATH ~/.local/bin

set -gx MANPAGER "sh -c 'sed -u -e \"s/\\x1B\\[[0-9;]*m//g; s/.\\x08//g\" | bat -p -lman'"

set -gx npm_config_cache $XDG_CACHE_HOME/npm
set -gx npm_config_prefix $HOME/.local

set -gx OPENCLAW_HOME $XDG_DATA_HOME/openclaw
set -gx OPENCLAW_STATE_DIR $XDG_STATE_HOME/openclaw
set -gx OPENCLAW_CONFIG_PATH $XDG_CONFIG_HOME/openclaw/openclaw.json
set -gx CLAWHUB_WORKDIR $XDG_CONFIG_HOME/opencode/skills

set -gx OPENCODE_EXPERIMENTAL 1

set -gx CARGO_HOME ~/.local/share/cargo
set -gx RUSTUP_HOME ~/.local/share/rustup

set -gx TLRC_CONFIG $XDG_CONFIG_HOME/tldr/config.toml

set -gx _ZO_DATA_DIR $XDG_DATA_HOME/zoxide
set -gx _ZO_RESOLVE_SYMLINKS 1
