{{ if eq .os "darwin" -}}
fish_add_path --global --move --path "/opt/homebrew/bin" "/opt/homebrew/sbin"

fish_add_path --global --move --path /Applications/Surge.app/Contents/Applications
fish_add_path --global --move --path /opt/homebrew/opt/coreutils/libexec/gnubin
fish_add_path --global --move --path /opt/homebrew/opt/curl/bin
fish_add_path --global --move --path /opt/homebrew/opt/openjdk/bin
fish_add_path --global --move --path /opt/homebrew/opt/openssh/bin
fish_add_path --global --move --path /opt/homebrew/opt/openssl/bin
fish_add_path --global --move --path /opt/homebrew/opt/python/bin
fish_add_path --global --move --path /opt/homebrew/opt/sqlite/bin

{{ else -}}

{{   if ne .os "nixos" -}}
{{     if eq .chezmoi.version.builtBy "Homebrew" -}}
fish_add_path --global --move --path "/home/linuxbrew/.linuxbrew/bin" "/home/linuxbrew/.linuxbrew/sbin"
{{     end -}}

fish_add_path --path /usr/lib/podman
fish_add_path --path /usr/lib/systemd/system-generators
{{   end -}}
{{ end -}}

fish_add_path --path ~/.local/bin
fish_add_path --path $CARGO_HOME/bin
