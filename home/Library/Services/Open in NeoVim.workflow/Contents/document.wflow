				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>/usr/bin/env osascript - "$@" &lt;&lt;'APPLESCRIPT'
on run filePaths
    if (count of filePaths) is 0 then return

    tell application "Ghostty"
        set targetWindow to missing value
        if (count of windows) &gt; 0 then set targetWindow to front window

        repeat with filePath in filePaths
            set previousDelimiters to AppleScript's text item delimiters
            set AppleScript's text item delimiters to "/"
            set fileName to last text item of (filePath as text)
            set AppleScript's text item delimiters to previousDelimiters

            set cfg to new surface configuration
            set command of cfg to "/opt/homebrew/bin/nvim -- " &amp; quoted form of (filePath as text)

            if targetWindow is missing value then
                set targetWindow to new window with configuration cfg
                set editorTab to selected tab of targetWindow
            else
                set editorTab to new tab in targetWindow with configuration cfg
                select tab editorTab
            end if
            set name override of editorTab to "nvim " &amp; fileName
        end repeat

        activate
    end tell
end run
APPLESCRIPT
</string>
