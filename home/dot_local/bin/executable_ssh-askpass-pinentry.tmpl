#!/usr/bin/env fish

{{ if eq .chezmoi.os "darwin" -}}
set -l pinentry /opt/homebrew/bin/pinentry-mac
{{ else if eq .chezmoi.os "linux" -}}
set -l pinentry /usr/bin/pinentry-gtk
{{ else -}}
exit 1
{{ end -}}

if not test -x "$pinentry"
    exit 1
end

set -l response (
    printf '%s\n' \
        'SETTITLE OpenSSH' \
        'SETDESC Enter the passphrase for your SSH private key.' \
        'SETPROMPT Passphrase:' \
        'GETPIN' \
        'BYE' | $pinentry
)

for line in $response
    if string match --quiet --regex '^D ' -- $line
        string replace --regex '^D ' '' -- $line | string unescape --style=url
        exit 0
    end
end

exit 1
