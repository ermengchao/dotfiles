#!/usr/bin/env fish

{{ if and (eq .chezmoi.os "linux") (ne .chezmoi.osRelease.id "nixos") -}}
  {{ if eq .chezmoi.version.builtBy "Homebrew" -}}
sudo /usr/bin/env \
    HOME=/root \
    XDG_CONFIG_HOME=/root/.config \
    XDG_DATA_HOME=/root/.local/share \
    XDG_STATE_HOME=/root/.local/state \
    XDG_CACHE_HOME=/root/.cache \
    PATH={{ env "HOMEBREW_PREFIX" }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    {{ env "HOMEBREW_PREFIX" }}/bin/chezmoi apply \
    --init \
    --source {{ .paths.rootSourceDir }} \
    --destination / \
    $argv
  {{ else -}}
sudo /usr/bin/env \
    HOME=/root \
    XDG_CONFIG_HOME=/root/.config \
    XDG_DATA_HOME=/root/.local/share \
    XDG_STATE_HOME=/root/.local/state \
    XDG_CACHE_HOME=/root/.cache \
    /usr/bin/chezmoi apply \
    --init \
    --source {{ .paths.rootSourceDir }} \
    --destination / \
    $argv
  {{ end -}}
{{ end -}}
