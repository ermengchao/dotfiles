# General
mode: rule
log-level: info
ipv6: true
find-process-mode: strict
tcp-concurrent: true
unified-delay: true

profile:
  store-selected: true
  store-fake-ip: true

# Use the same GeoIP database as Surge's GEOIP,CN rule.
geodata-mode: false
geo-auto-update: true
geo-update-interval: 24
geox-url:
  mmdb: https://github.com/Hackl0us/GeoIP2-CN/raw/release/Country.mmdb

# External access
allow-lan: true
bind-address: "*"
port: {{ .ports.proxy.http }}
socks-port: {{ .ports.proxy.socks }}
external-controller: 0.0.0.0:{{ .ports.clash_api }}
secret: {{ onepasswordRead "op://Development/chao/password" | quote }}
external-ui: ./ui
external-ui-url: https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip
external-controller-cors:
  allow-origins:
    - "*"
  allow-private-network: true

# DNS
dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/15
  fake-ip-range6: fdfe:dcba:9876::1/64
  # Match Surge Mac's fake-IP TTL; address allocation itself differs.
  fake-ip-ttl: 30
  # Preserve Surge wildcards such as *proxy... using regex, not label-only globs.
  fake-ip-filter-mode: rule
  fake-ip-filter:
    - DOMAIN,localhost,real-ip
    - DOMAIN-SUFFIX,local,real-ip
    - DOMAIN-REGEX,(?i)^.*\.taileee60e\.ts\.net$,real-ip
    - DOMAIN-REGEX,(?i)^xbox\..*\.microsoft\.com$,real-ip
    - DOMAIN-REGEX,(?i)^.*\.xboxlive\.com$,real-ip
    - DOMAIN-REGEX,(?i)^.*\.stun\.playstation\.net$,real-ip
    - DOMAIN-REGEX,(?i)^.*\.srv\.nintendo\.net$,real-ip
    - DOMAIN-REGEX,(?i)^.*\.battlenet\.com\.cn$,real-ip
    - DOMAIN-REGEX,(?i)^.*\.battlenet\.com$,real-ip
    - DOMAIN-REGEX,(?i)^.*\.blzstatic\.cn$,real-ip
    - DOMAIN-REGEX,(?i)^.*\.battle\.net$,real-ip
    - DOMAIN-REGEX,(?i)^.*proxy\.er\-meng\.com$,real-ip
    - DOMAIN,gslb.itv.jsinfo.net,real-ip
    - MATCH,fake-ip
  cache-algorithm: arc
  prefer-h3: false
  use-hosts: true
  use-system-hosts: true
  respect-rules: true
  # System DNS bootstraps DoH and proxy-node addresses without proxy recursion.
  default-nameserver:
    - system
  nameserver:
    - "https://cloudflare-dns.com/dns-query#🌐 Proxy"
  proxy-server-nameserver:
    - system
  nameserver-policy:
    "*.local": system
    "+.taileee60e.ts.net": tailscale://tailnet
    "rule-set:china_max_domain,direct_chao": "https://dns.alidns.com/dns-query#🟢 Direct"

hosts:
  # Unlike Surge, Mihomo also applies this mapping to matching proxy-node names.
  "*.proxy.er-meng.com": 18.177.110.208
  homeassistant.local: 10.10.10.17

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: false
  sniff:
    HTTP:
      ports:
        - 80
      override-destination: false
    TLS:
      ports:
        - 443

# TUN
tun:
  enable: true
  stack: mixed
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true
  strict-route: false
  dns-hijack:
    - any:53
    - tcp://any:53
  # Surge's skip-proxy is not a TUN exclusion or a DIRECT policy.
  # Keep only its explicit VIF exclusion; connected LAN routes remain OS-managed.
  route-exclude-address:
    - 224.0.0.0/4

# Outbounds
proxies:
  - name: "🇯🇵 Japan 01"
    type: ss
    server: apne1-01.proxy.er-meng.com
    port: {{ .ports.proxy.shadowsocks }}
    cipher: 2022-blake3-aes-128-gcm
    password: {{ onepasswordRead "op://Development/Proxy/shadowsocks/password" | quote }}
    udp: true

  - name: "🇯🇵 Japan 02"
    type: vmess
    server: apne1-01.proxy.er-meng.com
    port: 443
    uuid: {{ onepasswordRead "op://Development/Proxy/vmess/password" | quote }}
    alterId: 0
    cipher: auto
    udp: true
    tls: true
    servername: apne1-01.proxy.er-meng.com
    tfo: true
    network: ws
    ws-opts:
      path: /{{ onepasswordRead "op://Development/Proxy/vmess/password" }}
      headers:
        Host: apne1-01.proxy.er-meng.com

  - name: "🇯🇵 Japan 03"
    type: trojan
    server: apne1-01.proxy.er-meng.com
    port: {{ .ports.proxy.trojan }}
    password: {{ onepasswordRead "op://Development/Proxy/trojan/password" | quote }}
    sni: apne1-01.proxy.er-meng.com
    udp: true

  - name: "🇯🇵 Japan 04"
    type: snell
    server: apne1-01.proxy.er-meng.com
    port: {{ .ports.proxy.snell }}
    psk: {{ onepasswordRead "op://Development/Proxy/snell/password" | quote }}
    version: 5
    reuse: true
    udp: true

  - name: "🇯🇵 Japan 05"
    type: tuic
    server: apne1-01.proxy.er-meng.com
    port: {{ .ports.proxy.tuic }}
    uuid: {{ onepasswordRead "op://Development/Proxy/tuic/password" | quote }}
    password: {{ onepasswordRead "op://Development/Proxy/tuic/password" | quote }}
    sni: apne1-01.proxy.er-meng.com
    alpn:
      - h3
    congestion-controller: bbr
    reduce-rtt: false
    udp-relay-mode: native

  - name: "🇯🇵 Japan 06"
    type: hysteria2
    server: apne1-01.proxy.er-meng.com
    port: {{ .ports.proxy.hysteria2 }}
    password: {{ onepasswordRead "op://Development/Proxy/hysteria2/password" | quote }}
    sni: apne1-01.proxy.er-meng.com

  - name: "🇯🇵 Japan 07"
    type: anytls
    server: apne1-01.proxy.er-meng.com
    port: {{ .ports.proxy.anytls }}
    password: {{ onepasswordRead "op://Development/Proxy/anytls/password" | quote }}
    sni: apne1-01.proxy.er-meng.com
    udp: true

  # Requires a Mihomo build with Tailscale support (validated with v1.19.32).
  # Omit auth-key: the first routed request prints an interactive login URL.
  - name: tailnet
    type: tailscale
    state-dir: ./tailscale
    ephemeral: false
    udp: true
    accept-routes: true

proxy-groups:
  - name: "🟢 Direct"
    type: select
    proxies:
      - DIRECT
    hidden: true

  - name: "🔴 Reject"
    type: select
    proxies:
      - REJECT
    hidden: true

  - name: "🌐 Proxy"
    type: select
    proxies:
      - "✨ Auto"
      - "🇯🇵 Japan 01"
      - "🇯🇵 Japan 02"
      - "🇯🇵 Japan 03"
      - "🇯🇵 Japan 04"
      - "🇯🇵 Japan 05"
      - "🇯🇵 Japan 06"
      - "🇯🇵 Japan 07"

  # url-test is the closest built-in option; it cannot reproduce Surge Smart.
  - name: "✨ Auto"
    type: url-test
    url: http://www.google.com/generate_204
    interval: 300
    timeout: 2000
    hidden: true
    proxies:
      - "🇯🇵 Japan 01"
      - "🇯🇵 Japan 02"
      - "🇯🇵 Japan 03"
      - "🇯🇵 Japan 04"
      - "🇯🇵 Japan 05"
      - "🇯🇵 Japan 06"
      - "🇯🇵 Japan 07"

  # Keep Reject first to match Surge default=Reject without changing saved choices.
  - name: "📺 AD"
    type: select
    proxies:
      - "🔴 Reject"
      - "🌐 Proxy"
      - "🟢 Direct"

  - name: "🧠 AI"
    type: select
    proxies:
      - "🌐 Proxy"
      - "🟢 Direct"

  - name: "🎮 Game"
    type: select
    proxies:
      - "🌐 Proxy"
      - "🟢 Direct"

  - name: "🎥 Media"
    type: select
    proxies:
      - "🌐 Proxy"
      - "🟢 Direct"

  - name: "🐟 Final"
    type: select
    proxies:
      - "🌐 Proxy"
      - "🟢 Direct"

  - name: "🧩 Tailnet"
    type: select
    proxies:
      - tailnet
    hidden: true

  # Surge's Mac mini uses Snell v6, which Mihomo cannot implement.
  - name: "🎛️ Exit Node"
    type: select
    proxies:
      - "🧩 Tailnet"

rules:
  # Approximate Surge pre-matching with the first ordinary rule.
  # REJECT-DROP is unsupported; REJECT provides the closest available block.
  - IP-CIDR,10.10.10.65/32,REJECT,no-resolve
  - SRC-IP-CIDR,10.10.10.17/32,DIRECT
  - DOMAIN,dns.alidns.com,🟢 Direct
  - DOMAIN,cloudflare-dns.com,🌐 Proxy
  # Pin internal DoH transport policies; Mihomo has no PROTOCOL,DOH rule.
  - DOMAIN-SUFFIX,er-meng.com,🟢 Direct

  # Explicit overlay routes approximate Surge's automatic Tailnet peer routing.
  - DOMAIN-SUFFIX,taileee60e.ts.net,🧩 Tailnet
  - IP-CIDR,100.64.0.0/10,🧩 Tailnet,no-resolve
  - IP-CIDR6,fd7a:115c:a1e0::/48,🧩 Tailnet,no-resolve

  - RULE-SET,advertising,🔴 Reject
  - RULE-SET,ai_chao,🧠 AI
  - RULE-SET,claude,🧠 AI
  - RULE-SET,copilot,🧠 AI
  - RULE-SET,gemini,🧠 AI
  - RULE-SET,openai,🧠 AI
  - RULE-SET,direct_chao,🟢 Direct
  - RULE-SET,download,🟢 Direct
  - RULE-SET,lan,🟢 Direct
  - RULE-SET,game_chao,🎮 Game
  - RULE-SET,game,🎮 Game
  - RULE-SET,disney,🎥 Media
  - RULE-SET,netflix,🎥 Media
  - RULE-SET,hbo_usa,🎥 Media
  - RULE-SET,spotify,🎥 Media
  - RULE-SET,tiktok,🎥 Media
  - RULE-SET,youtube,🎥 Media
  - RULE-SET,youtube_music,🎥 Media
  - RULE-SET,proxy_chao,🌐 Proxy
  - RULE-SET,amazon_cloud,🌐 Proxy
  - RULE-SET,apple_proxy,🌐 Proxy
  - RULE-SET,developer,🌐 Proxy
  - RULE-SET,github,🌐 Proxy
  - RULE-SET,google,🌐 Proxy
  - RULE-SET,icloud_private_relay,🌐 Proxy
  - RULE-SET,siri,🌐 Proxy

  # 🔴 Reject
  - RULE-SET,reject_chao,🔴 Reject

  - RULE-SET,apple,🟢 Direct
  - RULE-SET,china_max,🟢 Direct
  - RULE-SET,global,🌐 Proxy
  - GEOIP,CN,🟢 Direct
  # DNS failures may continue here, but Surge's direct jump to FINAL differs.
  - MATCH,🐟 Final

rule-providers:
