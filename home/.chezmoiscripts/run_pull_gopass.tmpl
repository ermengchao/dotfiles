#!/usr/bin/env fish

set root_password_store (string replace -r '^~/' "$HOME/" -- (gopass config mounts.path))
if test -d "$root_password_store"; and test -n (ls -A "$root_password_store" | string collect)
    set -x GIT_AUTHOR_NAME {{ .username | quote }}
    set -x GIT_AUTHOR_EMAIL {{ .email | quote }}

    gopass --yes git -- pull --ff-only > /dev/null
end
