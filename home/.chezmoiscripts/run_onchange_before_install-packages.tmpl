#!/usr/bin/env fish

{{ if or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (ne .chezmoi.osRelease.id "nixos")) -}}
{{ range .meta.packageManager -}}
{{ $packageMap := index $.packageManagers . }}{{ if $.meta.isMinimal }}{{ $packageMap = index $.packageManagers . "minimal" }}{{ end -}}

{{   if eq . "brew" -}}
{{     if eq $.chezmoi.os "darwin" -}}
set brew_prefix /opt/homebrew
{{     end -}}
{{     if eq $.chezmoi.os "linux" -}}
set brew_prefix /home/linuxbrew/.linuxbrew
{{     end -}}

{{ range index $packageMap $.chezmoi.os "taps" -}}
$brew_prefix/bin/brew trust {{ . | quote }} > /dev/null
{{ end -}}

begin

    {{ range index $packageMap $.chezmoi.os "taps" -}}
    echo 'tap {{ . | quote }}'
    {{ end -}}

    {{ range index $packageMap $.chezmoi.os "brews" -}}
    echo 'brew {{ . | quote }}'
    {{ end -}}

    {{ range index $packageMap $.chezmoi.os "casks" -}}
    echo 'cask {{ . | quote }}'
    {{ end -}}

    {{ with index $packageMap $.chezmoi.os "mas" -}}

    {{ range . -}}
    echo 'mas {{ .name | quote }}, id: {{ .id }}'
    {{ end -}}

    {{ end -}}

end | $brew_prefix/bin/brew bundle --file=/dev/stdin > /dev/null
{{     if eq $.chezmoi.os "darwin" -}}
printf "🧑‍💻 Linking core services to /Applications...\n"
sudo ln -s "/System/Library/CoreServices/Applications" "/Applications/CoreServices"
printf "✅ Done.\n"
printf "🧑‍💻 Linking Xcode tools to /Applications...\n"
sudo ln -s "/Applications/Xcode.app/Contents/Applications" "/Applications/Developer Tools"
printf "✅ Done.\n"

defaults write org.hammerspoon.Hammerspoon MJConfigFile "~/.config/hammerspoon/init.lua"
{{     end -}}
{{   else -}}
{{ $installer := "" }}{{ if (index $.packageManagers .).root }}{{ $installer = "sudo " }}{{ end -}}
{{ $manager := . -}}
{{ $command := index $.packageManagers . "command" -}}
{{ $argList := index $.packageManagers . "args" -}}

{{ range (index $packageMap "packages") -}}
{{ $installer -}} {{ $manager }} {{ $command }} {{ range $argList }} {{ . }} {{ end }} {{ . | quote }} > /dev/null
{{ end -}}

{{   end -}}
{{ end -}}

{{ end -}}
