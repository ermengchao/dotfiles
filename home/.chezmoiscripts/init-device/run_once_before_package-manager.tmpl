#!/usr/bin/env fish

{{ if or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (ne .chezmoi.osRelease.id "nixos")) -}}
{{ range .meta.packageManager -}}
{{   if eq . "brew" -}}
{{     if eq $.chezmoi.os "darwin" -}}
set brew_path /opt/homebrew/bin/brew
{{     end -}}
{{     if eq $.chezmoi.os "linux" -}}
set brew_path /home/linuxbrew/.linuxbrew/bin/brew
{{     end -}}

if not test -x $brew_path
    printf "🍺 Homebrew not found. Installing homebrew...\n"

    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    printf "ℹ️ Sourcing homebrew shell env...\n"

    $brew_path shellenv fish | source
    printf "✅ Done.\n"
end
{{   end -}}

{{   if eq . "paru" -}}
set paru_path ~/.local/share/repos/paru

if not type -q paru
    printf "📦 Paru not found. Installing paru to $paru_path...\n"

    set -x CARGO_HOME ~/.local/share/cargo
    set -x RUSTUP_HOME ~/.local/share/rustup

    sudo pacman -S --needed --noconfirm base-devel rustup > /dev/null

    if test -d $paru_path/.git
        git -C $paru_path pull --ff-only
    else if test -e $paru_path
        printf "❌ $paru_path exists but is not a Git repository.\n"
        exit 1
    else
        mkdir -p (path dirname $paru_path)
        git clone https://aur.archlinux.org/paru.git $paru_path > /dev/null
    end

    cd $paru_path
    rustup default stable > /dev/null
    makepkg -si --noconfirm > /dev/null 2> /dev/null

    printf "✅ Done.\n"
end
{{   end -}}

{{   if eq . "flatpak" -}}
if not type -q flatpak
    printf "‼️ Flatpak not found. Please install it manually.\n"
    exit 1
end

printf "📦 Adding the flathub repositor...\n"

flatpak remote-add --user --if-not-exists flathub "https://dl.flathub.org/repo/flathub.flatpakrepo"

printf "✅ Done.\n"
{{   end -}}
{{ end -}}
{{ end -}}
