#!/usr/bin/env fish

{{ if ne .os "nixos" -}}
if not type -q gopass
    printf "‼️ Gopass is not available. Applying abort.\n"
    exit 1
end

gopass config age.agent-enabled true > /dev/null
gopass config age.agent-timeout {{ .agentTimeout }} > /dev/null

{{   if .meta.isRootNode -}}
if not test -s ~/.config/gopass/age/identities
    printf "‼️ Gopass age identity file not found. Import your native age identity with 'gopass age identities add' before applying.\n"
    exit 1
end

gopass config core.autopush true > /dev/null
gopass config core.autosync true > /dev/null
{{   else -}}
if not test -f ~/.ssh/id_ed25519
    printf "‼️ SSH private key, which is used as gopass age identity could not found. Applying abort.\n"
    exit 1
end

gopass config core.autopush false > /dev/null
gopass config core.autosync false > /dev/null
gopass config age.ssh-key-path "$HOME/.ssh" > /dev/null
set -gx GOPASS_SSH_DIR ~/.ssh
{{   end -}}

set root_password_store (/usr/bin/env gopass config mounts.path | string replace -r '^~' {{ .chezmoi.homeDir | quote }})
if not test -d "$root_password_store"; or test -z (ls -A "$root_password_store" | string collect)
    printf "🧑‍💻 Cloning root password store...\n"

    if not set -q GOPASS_AGE_PASSWORD
        printf "ℹ️ GOPASS_AGE_PASSWORD not set. Falling back to interactive mode.\n"

        if test -t 0
            set -gx GPG_TTY (tty)
        else
            printf "‼️ No interactive terminal is available for pinentry.\n"
            exit 1
        end
    else
        set -x GOPASS_AGE_PASSWORD $GOPASS_AGE_PASSWORD
    end

    set -x GIT_AUTHOR_NAME {{ .username | quote }}
    set -x GIT_AUTHOR_EMAIL {{ .email | quote }}
    gopass --yes clone --crypto age {{ .gitHostUrl }}/{{ .fullname }}/credentials

    printf "✅ Done.\n"
end

cd "$root_password_store"
if not string match -q "credentials" (git remote | string trim)
    git remote add credentials {{ .gitHostUrl }}/{{ .fullname }}/credentials > /dev/null
    git fetch --quiet credentials
end

{{ end -}}
