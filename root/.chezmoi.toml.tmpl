{{ $os := .chezmoi.os -}}
{{ if hasKey .chezmoi.osRelease "id" -}}
{{   $os = .chezmoi.osRelease.id -}}
{{ end -}}

[env]
XDG_CACHE_HOME = "/root/.cache"
XDG_CONFIG_HOME = "/root/.config"
XDG_DATA_HOME = "/root/.local/share"
XDG_STATE_HOME = "/root/.local/state"

[data]
username = "chao"

os = {{ $os | quote }}

[data.meta]
hostname = {{ .chezmoi.hostname | toToml }}

[data.ports]
vnc = 5900
